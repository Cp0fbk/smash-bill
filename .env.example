# ==============================================================================
# SmashBill - Environment Variables Template
# Copy this file to .env and fill in the values for local development
# ==============================================================================

# --- Database (PostgreSQL + Prisma) ---
POSTGRES_USER=smashbill
POSTGRES_PASSWORD=smashbill_secret
POSTGRES_DB=smashbill_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://smashbill:smashbill_secret@localhost:5432/smashbill_db?schema=public"

# --- Backend API (NestJS) ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="replace-with-strong-jwt-secret-key"

# --- SSO Providers (Phase 1: Google & Zalo Only) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_CALLBACK_URL="http://localhost:4000/api/v1/auth/zalo/callback"

# --- VietQR Integration ---
VIETQR_IMAGE_BASE_URL="https://img.vietqr.io/image"
VIETQR_DEFAULT_TEMPLATE="compact2"

# --- Frontend Web (Next.js PWA) ---
NEXT_PUBLIC_APP_NAME="SmashBill"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
