// ============================================================================
// SmashBill - Prisma Schema (v2: Append-Only Ledger, Expenses & Public Tokens)
// Domain: Badminton Club Attendance, Cost Splitting, VietQR Billing & Community
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum AuthProvider {
  GOOGLE
  ZALO
}

enum AccountStatus {
  ACTIVE
  SHADOWBANNED
  BANNED
}

enum Sport {
  BADMINTON
}

enum ClubRole {
  ADMIN
  MEMBER
  GUEST
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SplitStrategyType {
  EQUAL
  WEIGHTED
  GUEST_FIXED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ExpenseCategory {
  COURT
  SHUTTLECOCK
  WATER
  REFEREE
  OTHER
}

enum LedgerEntryType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  REFUND
  FUND_SURPLUS
}

enum PaymentRequestStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum ReportReason {
  FLAKING
  CLASSIFIED_SCAM
  SPAM
  OTHER
}

// ----------------------------------------------------------------------------
// Core Models (Phase 0 Schema v2 - MVP & Phase 1 Trust System)
// ----------------------------------------------------------------------------

model User {
  id             String        @id @default(cuid())
  provider       AuthProvider
  providerId     String
  email          String?       @unique
  name           String
  phone          String?
  avatarUrl      String?
  skillLevel     String?       // e.g., TB-, TB, TB+, Kha
  flakeCount     Int           @default(0)
  totalMatches   Int           @default(0)
  thumbsUp       Int           @default(0)
  thumbsDown     Int           @default(0)
  status         AccountStatus @default(ACTIVE)
  shadowbanUntil DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  ownedClubs           Club[]              @relation("ClubOwner")
  memberships          ClubMember[]
  createdExpenses      Expense[]           @relation("ExpenseCreator")
  createdLedgerEntries LedgerEntry[]       @relation("LedgerEntryCreator")
  listings             ClassifiedListing[]
  reportsMade          UserReport[]        @relation("Reporter")
  reportsAgainst       UserReport[]        @relation("ReportedUser")

  @@unique([provider, providerId])
  @@index([status])
}

model Club {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  location        String?
  sport           Sport    @default(BADMINTON)
  inviteCode      String   @unique
  publicToken     String   @unique
  bankBin         String?  // NAPAS Bank BIN (e.g., "970436" for Vietcombank)
  bankAccountNo   String?  // Admin bank account number for VietQR
  bankAccountName String?  // Account holder name
  defaultCourtFee Int      @default(0) // VND
  ownerId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  owner           User             @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         ClubMember[]
  matches         Match[]
  expenses        Expense[]
  ledgerEntries   LedgerEntry[]
  paymentRequests PaymentRequest[]

  @@index([ownerId])
}

model ClubMember {
  id          String   @id @default(cuid())
  clubId      String
  userId      String?  // Nullable for Single-Player Admin mode (members don't need an account)
  displayName String
  phone       String?
  role        ClubRole @default(MEMBER)
  publicToken String   @unique
  isActive    Boolean  @default(true)
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  club            Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendances     Attendance[]
  ledgerEntries   LedgerEntry[]
  paymentRequests PaymentRequest[]

  @@unique([clubId, userId])
  @@index([clubId])
}

model Match {
  id            String            @id @default(cuid())
  clubId        String
  title         String
  scheduledAt   DateTime
  location      String?
  courtCount    Int               @default(1)
  guestDeposit  Int               @default(50000) // Anti-flaking deposit for drop-in guests (VND)
  splitStrategy SplitStrategyType @default(EQUAL)
  status        MatchStatus       @default(SCHEDULED)
  settledAt     DateTime?
  version       Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  club          Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  attendances   Attendance[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]

  @@index([clubId, scheduledAt])
}

model Attendance {
  id           String           @id @default(cuid())
  matchId      String
  clubMemberId String
  status       AttendanceStatus @default(PRESENT)
  isGuest      Boolean          @default(false)
  depositPaid  Boolean          @default(false)
  amountOwed   Int              @default(0) // Calculated share for this match (VND)
  isSettled    Boolean          @default(false)
  checkedInAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  clubMember ClubMember @relation(fields: [clubMemberId], references: [id], onDelete: Cascade)

  @@unique([matchId, clubMemberId])
  @@index([matchId])
  @@index([clubMemberId])
}

model Expense {
  id          String          @id @default(cuid())
  matchId     String
  clubId      String
  category    ExpenseCategory
  amount      Int             // Integer VND
  note        String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  match     Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  club      Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User  @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@index([clubId])
}

model LedgerEntry {
  id           String          @id @default(cuid())
  clubId       String
  clubMemberId String?
  matchId      String?
  type         LedgerEntryType
  amount       Int             // Signed integer VND (+ member owes, - member paid, + fund surplus)
  note         String?
  voidedAt     DateTime?
  createdById  String?
  createdAt    DateTime        @default(now())

  // Relations
  club       Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubMember ClubMember? @relation(fields: [clubMemberId], references: [id], onDelete: Restrict)
  match      Match?      @relation(fields: [matchId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("LedgerEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clubId, clubMemberId])
  @@index([matchId])
}

model PaymentRequest {
  id           String               @id @default(cuid())
  clubId       String
  clubMemberId String
  amount       Int                  // Integer VND
  transferNote String               // Standardized VietQR transfer syntax
  qrPayload    String               // EMVCo / VietQR payload or URL
  status       PaymentRequestStatus @default(PENDING)
  paidAt       DateTime?
  createdAt    DateTime             @default(now())

  // Relations
  club       Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  clubMember ClubMember @relation(fields: [clubMemberId], references: [id], onDelete: Restrict)

  @@index([clubMemberId, status])
  @@index([clubId])
}

// ----------------------------------------------------------------------------
// Phase 1 Community Expansion: Gear Classifieds & Trust/Anti-Flaking Reports
// ----------------------------------------------------------------------------

model ClassifiedListing {
  id           String   @id @default(cuid())
  sellerId     String
  title        String
  category     String   // RACKET, SHOES, BAG, ACCESSORY
  price        Int      // VND
  condition    String   // NEW, LIKE_NEW, USED
  description  String
  imageUrls    String[]
  contactZalo  String?
  contactPhone String?
  isSold       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, isSold])
}

model UserReport {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String
  reason         ReportReason
  details        String?
  createdAt      DateTime     @default(now())

  reporter     User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reportedUserId])
}
